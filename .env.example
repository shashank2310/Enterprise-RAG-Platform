# Local development only. Replace before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Development only: enables a fixed local demo identity without Entra sign-in.
LOCAL_DEMO_AUTH=true

# API registration IDs (public identifiers, not secrets).
API_ENTRA_TENANT_ID=
API_ENTRA_CLIENT_ID=

# Public React SPA configuration; never put secrets in VITE_* variables.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://<api-application-id>/access_as_user
VITE_API_BASE_URL=http://localhost:5283

# Local Ollama models; use a model size your hardware can run comfortably.
OLLAMA_CHAT_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
