# Local development only. Replace before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Public React SPA configuration; never put secrets in VITE_* variables.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://<api-application-id>/access_as_user
VITE_API_BASE_URL=http://localhost:5283
